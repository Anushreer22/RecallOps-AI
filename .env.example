# RecallOps-AI Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.

# Database Configuration
DATABASE_URL=sqlite:///./recallops.db

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Webhook Ingestion & Security
PAGERDUTY_WEBHOOK_SECRET=your-pagerduty-secret-here
DATADOG_WEBHOOK_TOKEN=your-datadog-webhook-token-here
ALERTMANAGER_WEBHOOK_TOKEN=your-alertmanager-bearer-token-here
WEBHOOK_AUTH_REQUIRED=true
WEBHOOK_MAX_PAYLOAD_BYTES=2097152

# Operational Settings
SIMILARITY_THRESHOLD=0.15
MAX_HISTORICAL_RECALL=5
